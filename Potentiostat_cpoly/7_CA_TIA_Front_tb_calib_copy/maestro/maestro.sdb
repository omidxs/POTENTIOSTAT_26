				<overwritehistory>0</overwritehistory>
				<tests>
					<test enabled="1">Potentiostat_7_CA_TIA_Front_tb_calib_1
						<tool>ADE</tool>
						<tooloptions>
							<option>cell
								<value>7_CA_TIA_Front_tb_calib_copy</value>
							</option>
							<option>lib
								<value>Potentiostat_cpoly</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>schematic6</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>state
								<value>Interactive.250</value>
							</option>
						</tooloptions>
						<outputs>
							<output>/CE
								<evalType>point</evalType>
							</output>
							<output>/RE
								<evalType>point</evalType>
							</output>
							<output>/Vout
								<evalType>point</evalType>
							</output>
							<output>Bias error
								<evalType>point</evalType>
							</output>
							<output>Output noise
								<evalType>point</evalType>
							</output>
							<output>CA Error
								<evalType>point</evalType>
							</output>
							<output>rmsNoise(0.001 100000)
								<evalType>point</evalType>
							</output>
							<output>PSRR
								<evalType>point</evalType>
							</output>
							<output>/VDDA
								<evalType>point</evalType>
							</output>
							<output>TIA_Error_Adjusted
								<evalType>point</evalType>
							</output>
							<output>Phase Margin
								<evalType>point</evalType>
							</output>
							<output>MUX leakage
								<evalType>point</evalType>
							</output>
							<output>MUX voltage drop
								<evalType>point</evalType>
							</output>
							<output>VDC("/I25/net8")
								<evalType>point</evalType>
							</output>
							<output>(VDC("/I25/net8") - VDC("/net1"))
								<evalType>point</evalType>
							</output>
							<output>(VDC("/vref") - VDC("/net1"))
								<evalType>point</evalType>
							</output>
							<output>((VDC("/net1") - VDC("/Vout")) / IDC("/I25/IPRB0/PLUS"))
								<evalType>point</evalType>
							</output>
							<output>Vout_noise/Rf
								<evalType>point</evalType>
							</output>
							<output>rmsNoise(0.01 100000)
								<evalType>point</evalType>
							</output>
						</outputs>
						<vars>
							<var>Idc
