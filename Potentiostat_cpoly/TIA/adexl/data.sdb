				</dependentTests>
			</var>
			<var>vref
				<value>1.65</value>
				<dependentTests>
					<dependentTest enabled="1" omitted="0">MC</dependentTest>
					<dependentTest enabled="1">Potentiostat:CA:1</dependentTest>
					<dependentTest enabled="1">Linearity</dependentTest>
				</dependentTests>
			</var>
			<var enabled="0">Vb
				<value>1.85</value>
				<dependentTests>
					<dependentTest enabled="1" omitted="0">MC</dependentTest>
					<dependentTest enabled="1">Potentiostat:CA:1</dependentTest>
				</dependentTests>
			</var>
			<var>vddpuls
				<value>0</value>
				<dependentTests>
					<dependentTest enabled="1">Potentiostat:CA:1</dependentTest>
					<dependentTest enabled="1">Linearity</dependentTest>
				</dependentTests>
			</var>
			<var enabled="0">I_EC
				<value>300n</value>
				<dependentTests>
					<dependentTest enabled="1">Potentiostat:CA:1</dependentTest>
				</dependentTests>
			</var>
			<var enabled="0">R_ct
				<value>mag((VAR( "Vb" )-VAR( "vref" ))/10n), mag((VAR( "Vb" )-VAR( "vref" ))/500n)</value>
				<dependentTests>
					<dependentTest enabled="1">Potentiostat:CA:1</dependentTest>
				</dependentTests>
			</var>
			<var>Idc
				<value>0</value>
				<dependentTests>
					<dependentTest omitted="0">Potentiostat:CA:1</dependentTest>
					<dependentTest enabled="1">Linearity</dependentTest>
				</dependentTests>
			</var>
