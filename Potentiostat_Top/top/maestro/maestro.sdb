				<overwritehistory>0</overwritehistory>
				<tests>
					<test enabled="1">Potentiostat_7_CA_TIA_Front_tb_calib_1
						<tool>ADE</tool>
						<tooloptions>
							<option>cell
								<value>top</value>
							</option>
							<option>lib
								<value>Potentiostat_Top</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>config</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>state
								<value>Interactive.231</value>
							</option>
						</tooloptions>
						<outputs>
							<output>/CE
								<evalType>point</evalType>
							</output>
							<output>/RE
								<evalType>point</evalType>
							</output>
							<output>"/POT_OUT"
								<evalType>point</evalType>
							</output>
							<output>Bias error
								<evalType>point</evalType>
							</output>
							<output>Output noise
								<evalType>point</evalType>
							</output>
							<output>CA Error
								<evalType>point</evalType>
							</output>
							<output>rmsNoise(0.001 100000)
								<evalType>point</evalType>
