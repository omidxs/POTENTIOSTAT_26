							</output>
							<output>(VDC("/vref") - VDC("/net1"))
								<evalType>point</evalType>
							</output>
							<output>((VDC("/net1") - VDC("/Vout")) / IDC("/I25/IPRB0/PLUS"))
								<evalType>point</evalType>
							</output>
							<output>rmsNoise(0.01 100000)
								<evalType>point</evalType>
							</output>
							<output>/POT_OUT
								<evalType>point</evalType>
							</output>
