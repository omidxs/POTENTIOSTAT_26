		<currentmode>Single Run, Sweeps and Corners</currentmode>
		<overwritehistory>0</overwritehistory>
		<tests>
			<test enabled="1">Poten
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>top</value>
					</option>
					<option>lib
						<value>Potentiostat_Top</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>config</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR</value>
					</option>
					<option>state
						<value>active</value>
					</option>
				</tooloptions>
				<outputs>
					<output>/CE
						<evalType>point</evalType>
					</output>
					<output>/RE
						<evalType>point</evalType>
					</output>
					<output>"/POT_OUT"
						<evalType>point</evalType>
					</output>
					<output>Bias error
						<evalType>point</evalType>
					</output>
					<output>Output noise
						<evalType>point</evalType>
					</output>
					<output>CA Loop Error
						<evalType>point</evalType>
					</output>
					<output>rmsNoise(0.001 100000)
						<evalType>point</evalType>
					</output>
					<output>PSRR
						<evalType>point</evalType>
					</output>
					<output>/VDDA
						<evalType>point</evalType>
					</output>
					<output>VDC("/I25/net8")
						<evalType>point</evalType>
					</output>
					<output>(VDC("/I25/net8") - VDC("/net1"))
						<evalType>point</evalType>
					</output>
					<output>(VDC("/vref") - VDC("/net1"))
						<evalType>point</evalType>
					</output>
					<output>((VDC("/net1") - VDC("/Vout")) / IDC("/I25/IPRB0/PLUS"))
						<evalType>point</evalType>
					</output>
					<output>rmsNoise(0.01 100000)
						<evalType>point</evalType>
					</output>
					<output>/POT_OUT
						<evalType>point</evalType>
					</output>
					<output>(VDC("/I2/vref") - VDC("/I2/net1"))
						<evalType>point</evalType>
					</output>
					<output>(VDC("/I2/vref") - VDC("/I2/TIA_IN"))
						<evalType>point</evalType>
					</output>
					<output>/WE
						<evalType>point</evalType>
					</output>
					<output>(VDC("/I2/V_EC") - VDC("/I2/net1"))
						<evalType>point</evalType>
					</output>
					<output>(VDC("/I2/net4") - VDC("/I2/net1"))
						<evalType>point</evalType>
					</output>
					<output>/Ib8
						<evalType>point</evalType>
					</output>
					<output>TIA loop Error
						<evalType>point</evalType>
					</output>
				</outputs>
				<vars>
					<var>Idc
						<value>0</value>
					</var>
					<var>Iin_TIA_AC
						<value>0</value>
					</var>
					<var>Ipulse
						<value>0</value>
					</var>
					<var>Vin_CA_AC
						<value>1</value>
					</var>
					<var>vpuls
						<value>-50m</value>
					</var>
					<var>Calib_EN
						<value></value>
					</var>
					<var>Cdl
						<value></value>
					</var>
					<var>Cdl_CE
						<value></value>
					</var>
					<var>PTAT_EN
						<value></value>
					</var>
					<var>R_ct
						<value></value>
					</var>
					<var>Rct_CE
						<value></value>
					</var>
					<var>Rs_CE
						<value></value>
					</var>
					<var>Rs_WE
						<value></value>
					</var>
					<var>Vb
						<value>1.7</value>
					</var>
					<var>vdd
						<value></value>
					</var>
					<var>vddpuls
						<value></value>
					</var>
					<var>vtran
						<value></value>
					</var>
					<var>S0
						<value></value>
					</var>
					<var>S1
						<value></value>
					</var>
					<var>S2
						<value></value>
					</var>
					<var>S3
						<value></value>
					</var>
				</vars>
			</test>
			<test enabled="1">TIA_Gain_Linearity
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>top</value>
					</option>
					<option>lib
						<value>Potentiostat_Top</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>config</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR</value>
					</option>
					<option>state
						<value>active</value>
					</option>
				</tooloptions>
				<outputs>
					<output>"/POT_OUT"
						<evalType>point</evalType>
					</output>
					<output>deriv(VS("/Vout"))
						<evalType>point</evalType>
					</output>
					<output>rmsNoise(0.001 100000)
						<evalType>point</evalType>
					</output>
					<output>/POT_OUT
						<evalType>point</evalType>
					</output>
					<output>deriv(VS("/POT_OUT"))
						<evalType>point</evalType>
					</output>
					<output>VDC("/I2/I25/net8")
						<evalType>point</evalType>
					</output>
					<output>VDC("/I2/net1")
						<evalType>point</evalType>
					</output>
				</outputs>
				<vars>
					<var>Idc
						<value>0</value>
					</var>
					<var>Iin_TIA_AC
						<value>1</value>
					</var>
					<var>Ipulse
						<value>0</value>
					</var>
					<var>Vin_CA_AC
						<value>0</value>
					</var>
					<var>vpuls
						<value>0</value>
