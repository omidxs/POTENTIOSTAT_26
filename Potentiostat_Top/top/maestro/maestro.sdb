					<test enabled="1">TIA_Gain_Linearity
						<tool>ADE</tool>
						<tooloptions>
							<option>cell
								<value>top</value>
							</option>
							<option>lib
								<value>Potentiostat_Top</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>schematic</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>state
								<value>Interactive.232</value>
							</option>
						</tooloptions>
						<outputs>
							<output>"/POT_OUT"
								<evalType>point</evalType>
							</output>
							<output>deriv(VS("/Vout"))
								<evalType>point</evalType>
							</output>
							<output>rmsNoise(0.001 100000)
								<evalType>point</evalType>
							</output>
							<output>/POT_OUT
								<evalType>point</evalType>
							</output>
							<output>deriv(VS("/POT_OUT"))
								<evalType>point</evalType>
							</output>
							<output>VDC("/I2/I25/net8")
								<evalType>point</evalType>
							</output>
							<output>VDC("/I2/net1")
								<evalType>point</evalType>
							</output>
							<output>VDC("/TIA_IN")
								<evalType>point</evalType>
							</output>
							<output>VDC("/I2/vref")
								<evalType>point</evalType>
							</output>
						</outputs>
