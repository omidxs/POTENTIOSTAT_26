				<overwritehistory>0</overwritehistory>
				<tests>
					<test enabled="1">Potentiostat_cpoly2:CA:1
						<tool>ADE</tool>
						<tooloptions>
							<option>cell
								<value>6_CA_TIA_Front_tb</value>
							</option>
							<option>lib
								<value>Potentiostat_cpoly2</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>schematic6</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>state
								<value>Potentiostat_cpoly2:CA:1_spectre_state1_Interactive.518</value>
							</option>
						</tooloptions>
						<origoptions>
							<option>cell
								<value>CA</value>
							</option>
							<option>lib
								<value>Potentiostat_cpoly2</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>schematic5</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>state
								<value>spectre_state1</value>
							</option>
						</origoptions>
					</test>
					<test enabled="1">TIA_Gain_linearity
						<tool>ADE</tool>
						<tooloptions>
							<option>cell
								<value>6_CA_TIA_Front_tb</value>
							</option>
							<option>lib
								<value>Potentiostat_cpoly2</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>schematic6</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>state
								<value>TIA_Gain_linearity_none_Interactive.518</value>
							</option>
						</tooloptions>
						<origoptions>
							<option>cell
								<value>6_CA_TIA_Front_tb</value>
							</option>
							<option>lib
								<value>Potentiostat_cpoly2</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>view
								<value>schematic6</value>
							</option>
						</origoptions>
					</test>
					<test enabled="1">MC
						<tool>ADE</tool>
						<tooloptions>
							<option>cell
								<value>6_CA_TIA_Front_tb</value>
							</option>
							<option>lib
								<value>Potentiostat_cpoly2</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>state
								<value>MC_Potentiostat:CA:1:1_state_Interactive.518</value>
							</option>
							<option>view
								<value>schematic6</value>
							</option>
						</tooloptions>
						<prerunscript>0</prerunscript>
						<origoptions>
							<option>cell
								<value>6_CA_TIA_Front_tb</value>
							</option>
							<option>lib
								<value>Potentiostat_cpoly2</value>
							</option>
							<option>path
								<value>$AXL_SETUPDB_DIR/test_states</value>
							</option>
							<option>sim
								<value>spectre</value>
							</option>
							<option>state
								<value>Potentiostat_cpoly2:CA:1:1_state</value>
							</option>
							<option>view
								<value>schematic6</value>
							</option>
						</origoptions>
					</test>
				</tests>
				<vars>
					<var>vdd
						<value>3.3</value>
						<dependentTests>
							<dependentTest enabled="1">TIA_Gain_linearity</dependentTest>
							<dependentTest enabled="1">MC</dependentTest>
							<dependentTest enabled="1">Potentiostat:CA:1</dependentTest>
						</dependentTests>
					</var>
					<var enabled="0">vpuls
						<value>0</value>
						<dependentTests>
							<dependentTest enabled="1">TIA_Gain_linearity</dependentTest>
							<dependentTest enabled="1">MC</dependentTest>
							<dependentTest enabled="1">Potentiostat:CA:1</dependentTest>
						</dependentTests>
					</var>
					<var enabled="1">vtran
						<value>0</value>
						<dependentTests>
							<dependentTest enabled="1">TIA_Gain_linearity</dependentTest>
							<dependentTest enabled="1">MC</dependentTest>
							<dependentTest enabled="1">Potentiostat:CA:1</dependentTest>
						</dependentTests>
					</var>
					<var>vref
						<value>1.6</value>
						<dependentTests>
							<dependentTest enabled="1">TIA_Gain_linearity</dependentTest>
							<dependentTest enabled="1">MC</dependentTest>
							<dependentTest enabled="1">Potentiostat:CA:1</dependentTest>
						</dependentTests>
					</var>
					<var>Vb
						<value>1.7</value>
						<dependentTests>
							<dependentTest enabled="1">TIA_Gain_linearity</dependentTest>
							<dependentTest enabled="1">MC</dependentTest>
							<dependentTest enabled="1">Potentiostat:CA:1</dependentTest>
						</dependentTests>
					</var>
					<var>vddpuls
						<value>0</value>
						<dependentTests>
							<dependentTest enabled="1">TIA_Gain_linearity</dependentTest>
							<dependentTest enabled="1">MC</dependentTest>
							<dependentTest enabled="1">Potentiostat:CA:1</dependentTest>
						</dependentTests>
					</var>
					<var enabled="1">R_ct
						<value>1M</value>
						<dependentTests>
							<dependentTest enabled="1">TIA_Gain_linearity</dependentTest>
							<dependentTest enabled="1">MC</dependentTest>
							<dependentTest enabled="1">Potentiostat:CA:1</dependentTest>
						</dependentTests>
					</var>
					<var>Ib8
						<value>200n</value>
