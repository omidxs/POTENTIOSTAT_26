		<tests>
			<test enabled="1">Potentiostat_cpoly2:CA:1
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>6_CA_TIA_Front_tb</value>
					</option>
					<option>lib
						<value>Potentiostat_cpoly2</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic6</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR/test_states</value>
					</option>
					<option>state
