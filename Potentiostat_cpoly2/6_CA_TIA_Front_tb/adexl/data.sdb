					</option>
				</tooloptions>
				<origoptions>
					<option>cell
						<value>CA</value>
					</option>
					<option>lib
						<value>Potentiostat_cpoly2</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic5</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR/test_states</value>
					</option>
					<option>state
						<value>spectre_state1</value>
					</option>
				</origoptions>
			</test>
			<test enabled="1">TIA_Gain_linearity
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>6_CA_TIA_Front_tb</value>
					</option>
					<option>lib
						<value>Potentiostat_cpoly2</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic6</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR/test_states</value>
					</option>
					<option>state
						<value>TIA_Gain_linearity_active</value>
					</option>
				</tooloptions>
				<origoptions>
					<option>cell
						<value>6_CA_TIA_Front_tb</value>
					</option>
					<option>lib
						<value>Potentiostat_cpoly2</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic6</value>
					</option>
				</origoptions>
			</test>
			<test enabled="1">MC
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>6_CA_TIA_Front_tb</value>
					</option>
					<option>lib
						<value>Potentiostat_cpoly2</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR/test_states</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>state
						<value>MC_active</value>
					</option>
					<option>view
						<value>schematic6</value>
					</option>
				</tooloptions>
				<prerunscript>0</prerunscript>
				<origoptions>
					<option>cell
						<value>6_CA_TIA_Front_tb</value>
					</option>
					<option>lib
						<value>Potentiostat_cpoly2</value>
					</option>
					<option>path
